  "cards": [
    {
      "dot": "slate",
      "title": "How to read",
      "items": [
        "Tagged \"planned\" and dashed: designed in OpenSpec, not built yet",
        "Everything else is built and host-tested at commit 61f6b99"
      ]
    },
    {
      "dot": "rose",
      "title": "Protection rules",
      "items": [
        "Output only after 500 ms of valid supply",
        "Overcurrent, brown-out, overvoltage: output cut at once",
        "Sustained current, undervoltage: Sleep",
        "After any fault nothing moves until a new request"
      ]
    },
    {
      "dot": "violet",
      "title": "Planned link and sensors",
      "items": [
        "Bridge replaces the serial hook; frames carry desired state, not events",
        "Robot sleeps if no valid frame arrives for 1 s",
        "Sensors read on core 1, handed to core 0 by seqlock; telemetry only for now"
      ]
    }
  ]
