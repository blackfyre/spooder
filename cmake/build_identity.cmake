# The firmware build identity: `git describe --always --dirty --abbrev=12` of
# the checkout, or `unknown` when git is missing or fails (no git, not a
# checkout). Writes a one-line C++ source defining build_identity::ID, and
# rewrites it only when its content changes, so an unchanged checkout
# recompiles nothing. Only git's output goes in: no time, user or host.
#
# Script mode, run by an always-run custom target in each build:
#   cmake -DREPO_ROOT=<checkout> -DOUTPUT=<generated .cpp> -P build_identity.cmake
# GIT_EXECUTABLE may name the git to run (default: `git` from PATH).

if(NOT DEFINED REPO_ROOT OR NOT DEFINED OUTPUT)
  message(FATAL_ERROR "build_identity.cmake: set -DREPO_ROOT=<checkout> and -DOUTPUT=<file>")
endif()
if(NOT DEFINED GIT_EXECUTABLE OR GIT_EXECUTABLE STREQUAL "")
  set(GIT_EXECUTABLE git)
endif()

set(identity unknown)
# A missing git leaves a non-zero (or non-numeric) result, as does a failing
# describe; both keep `unknown`.
execute_process(
  COMMAND "${GIT_EXECUTABLE}" -C "${REPO_ROOT}" describe --always --dirty --abbrev=12
  RESULT_VARIABLE describe_result
  OUTPUT_VARIABLE describe_output
  ERROR_QUIET
  OUTPUT_STRIP_TRAILING_WHITESPACE)
if(describe_result STREQUAL "0" AND NOT describe_output STREQUAL "")
  set(identity "${describe_output}")
endif()

# Escape for a C++ string literal: an annotated tag may contain `"`. (Git
# forbids `\` and `?` in ref names; `\` is escaped all the same.)
string(REPLACE "\\" "\\\\" literal "${identity}")
string(REPLACE "\"" "\\\"" literal "${literal}")

set(content "// Generated by cmake/build_identity.cmake: do not edit.\nnamespace build_identity { extern const char ID[] = \"${literal}\"; }\n")

set(previous "")
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" previous)
endif()
if(NOT previous STREQUAL content)
  file(WRITE "${OUTPUT}" "${content}")
endif()
